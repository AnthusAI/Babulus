{
  "all": true,
  "include": [
    "src/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/types.ts",
    "**/*.test.ts",
    "**/*.steps.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/*.config.ts",
    "apps/**"
  ],
  "reporter": [
    "text",
    "html",
    "json-summary"
  ],
  "report-dir": "./coverage",
  "temp-dir": "./.nyc_output"
}
