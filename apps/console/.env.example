# Copy to .env.local. All four are public identifiers, not secrets.
# The WebConsoleClientId output of the BabulusControlPlane stack.
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# The ApiUrl output of the same stack, with no trailing slash.
NEXT_PUBLIC_AURITUS_API_ENDPOINT=
NEXT_PUBLIC_AWS_REGION=us-east-1
# Only when cognito_domain_prefix is set in the private settings.
# NEXT_PUBLIC_COGNITO_DOMAIN=babulus-control-plane-auth
