  const { data, errors } = await client.models.OrgMember.update({
    id: member.id,
    role,
  });
  if (errors || !data) {
    throw new Error(`Failed to update org member role: ${errors?.map((e) => e.message).join(", ")}`);
  }
  return toControlPlaneOrgMember(data);
};

