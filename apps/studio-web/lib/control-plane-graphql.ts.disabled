    status: model.status as RenderRun["status"],
    mp4ArtifactKey: model.mp4ArtifactKey ?? null,
    stillsArtifactPrefix: model.stillsArtifactPrefix ?? null,
    logsArtifactKey: model.logsArtifactKey ?? null,
    createdAt: model.createdAt,
