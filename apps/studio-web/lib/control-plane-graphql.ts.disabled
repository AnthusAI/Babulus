export const setOrgMemberRole = async (
  userId: string,
  role: OrgMember["role"],
  activeOrgId: string,
): Promise<OrgMember> => {
  const { data: members } = await client.models.OrgMember.list({
    filter: {
      orgId: { eq: activeOrgId },
      userId: { eq: userId },
    },
