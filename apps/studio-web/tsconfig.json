{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "babulus/dsl": ["../../src/dsl/index.ts"],
      "@babulus/shared": ["../../packages/shared/src/index.ts"],
      "@babulus/renderer": ["../../packages/renderer/src/index.ts"],
      "@videoml/player": ["../../packages/videoml-player/src/index.ts"],
      "@videoml/player/react": ["../../packages/videoml-player/src/react.tsx"],
      "@videoml/stdlib": ["../../packages/videoml-stdlib/src/index.ts"],
      "@videoml/stdlib/dom": ["../../packages/videoml-stdlib/src/dom/index.ts"],
      "@videoml/stdlib/react": ["../../packages/videoml-stdlib/src/react/index.ts"],
      "@videoml/stdlib/tokens": ["../../packages/videoml-stdlib/src/tokens/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
