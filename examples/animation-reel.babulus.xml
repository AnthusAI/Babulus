<vml id="animation-reel" title="Animation Reel" fps="30" width="1920" height="1080">
  <voiceover />

  <scene id="reel-intro" title="Animation" styles='{"background":"var(--color-bg)"}'>
    <layer id="intro-title" z="20">
      <title props='{"text":"Animation","textAlign":"center","position":{"x":"50%","y":210},"fontSize":96,"fontWeight":700,"textColor":"var(--color-text, #ffffff)","color":"transparent","textEffect":{"effect":"shimmer","unit":"chars","durationFrames":22,"staggerFrames":2,"shimmerBrightness":1.6,"shimmerColorFrom":"var(--color-text, #f2f4f8)","shimmerColorTo":"var(--color-text-strong, #ffffff)"}}' />
      <subtitle props='{"text":"A menu of built-in features, or roll your own.","textAlign":"center","position":{"x":"50%","y":340},"fontSize":30,"fontWeight":500,"color":"var(--color-text-muted, #c7c2bc)"}' />
    </layer>
    <layer id="intro-demo" z="10">
      <gsap-principles-demo props='{"centerX":960,"centerY":420,"width":1200,"height":320}' />
    </layer>
    <cue id="hold-intro" label="hold-intro">
      <voice>Use any animation framework to create motion graphics and effects.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>

  <transition id="reel-push-0" effect="push" duration="12f" mode="insert" ease="power2.inOut" props='{"direction":"left"}' />

  <scene id="reel-framer" title="Framer" styles='{"background":"var(--color-bg)"}'>
    <layer id="engine-framer" z="10" styles='{"transform":"translateX(320px)"}'>
      <framer-motion-demo props='{"size":240,"centerX":1280,"centerY":540}' />
    </layer>
    <layer id="label-framer" z="20">
      <chapter-heading props='{"number":"01","showNumber":false,"title":"Animate your layout","subtitle":"With frameworks like GSAP, Framer Motion, etc","numberColor":"var(--color-accent)","layout":"stacked","align":"left","background":"transparent","numberEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1}}' />
    </layer>
    <cue id="hold-framer" label="hold-framer">
      <voice>The elements in your design don\u2019t need to sit still. Animate them with frameworks like Framer Motion.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>

  <transition id="reel-push-1" effect="push" duration="12f" mode="insert" ease="power2.inOut" props='{"direction":"left"}' />

  <scene id="reel-d3" title="D3" styles='{"background":"var(--color-bg)"}'>
    <layer id="engine-d3" z="10" styles='{"transform":"translateX(320px) scale(0.75)","transformOrigin":"center center"}'>
      <d3-bar-chart props='{"padding":180}' />
    </layer>
    <layer id="label-d3" z="20">
      <chapter-heading props='{"number":"02","showNumber":false,"title":"Visualize your data","subtitle":"With tools like D3.js","numberColor":"var(--color-accent)","layout":"stacked","align":"left","background":"transparent","numberEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1}}' />
    </layer>
    <cue id="hold-d3" label="hold-d3">
      <voice>Visualize data to tell the story behind the numbers, with tools like D3.js.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>

  <transition id="reel-push-2" effect="push" duration="12f" mode="insert" ease="power2.inOut" props='{"direction":"left"}' />

  <scene id="reel-processing" title="Processing" styles='{"background":"var(--color-bg)"}'>
    <layer id="engine-processing" z="10">
      <p5-particles props='{"particleCount":30,"overscanX":320,"focusX":0.66,"backgroundDarken":0.45}' />
    </layer>
    <layer id="label-processing" z="20">
      <chapter-heading props='{"number":"04","showNumber":false,"title":"Generative visuals","subtitle":"Built with Processing","numberColor":"var(--color-accent)","layout":"stacked","align":"left","background":"transparent","numberEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1}}' />
    </layer>
    <cue id="hold-processing" label="hold-processing">
      <voice>Create stunning visual art for backgrounds, transitions, and content with Processing.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>

  <transition id="reel-push-3" effect="push" duration="12f" mode="insert" ease="power2.inOut" props='{"direction":"left"}' />

  <scene id="reel-three" title="Three" styles='{"background":"var(--color-bg)"}'>
    <layer id="engine-three" z="10">
      <three-orbit props='{"cubeSize":160,"overscanX":320,"focusX":0.66}' />
    </layer>
    <layer id="label-three" z="20">
      <chapter-heading props='{"number":"03","showNumber":false,"title":"3D worlds and depth","subtitle":"Built with Three.js","numberColor":"var(--color-accent)","layout":"stacked","align":"left","background":"transparent","numberEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1}}' />
    </layer>
    <cue id="hold-three" label="hold-three">
      <voice>Build rich 3D scenes and spatial layers with Three.js.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>

  <transition id="reel-push-4" effect="push" duration="12f" mode="insert" ease="power2.inOut" props='{"direction":"left"}' />

  <scene id="reel-lottie" title="Lottie" styles='{"background":"var(--color-bg)"}'>
    <layer id="engine-lottie" z="10" styles='{"transform":"translateX(320px)"}'>
      <lottie-badge props='{"size":980}' />
    </layer>
    <layer id="label-lottie" z="20">
      <chapter-heading props='{"number":"05","showNumber":false,"title":"After Effects motion","subtitle":"Delivered with Lottie","numberColor":"var(--color-accent)","layout":"stacked","align":"left","background":"transparent","numberEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1}}' />
    </layer>
    <cue id="hold-lottie" label="hold-lottie">
      <voice>Bring motion graphics designed in After Effects straight into your video with Lottie.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>

  <transition id="reel-push-5" effect="push" duration="12f" mode="insert" ease="power2.inOut" props='{"direction":"left"}' />

  <scene id="reel-text" title="Text Effects" styles='{"background":"var(--color-bg)"}'>
    <layer id="engine-text" z="10" styles='{"transform":"translateX(420px)"}'>
      <text-effects-demo />
    </layer>
    <layer id="label-text" z="20">
      <chapter-heading props='{"number":"06","showNumber":false,"title":"Text effects","subtitle":"Curated effects + custom","numberColor":"var(--color-accent)","layout":"stacked","align":"left","background":"transparent","numberEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEffect":{"effect":"shimmer","unit":"chars","durationFrames":18,"staggerFrames":2,"shimmerBrightness":1.6,"shimmerColorFrom":"var(--color-text, #f2f4f8)","shimmerColorTo":"var(--color-text-strong, #ffffff)"}}' />
    </layer>
    <cue id="hold-text" label="hold-text">
      <voice>Choose from a menu of text effects, or craft your own animations.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>

  <transition id="reel-push-6" effect="push" duration="12f" mode="insert" ease="power2.inOut" props='{"direction":"left"}' />

  <scene id="reel-anime" title="Anime" styles='{"background":"var(--color-bg)"}'>
    <layer id="engine-anime" z="10" styles='{"transform":"translateX(270px) scale(0.74)","transformOrigin":"center center","overflow":"hidden"}'>
      <anime-harness-demo />
    </layer>
    <layer id="label-anime" z="20">
      <chapter-heading props='{"number":"07","showNumber":false,"title":"Layouts & grids","subtitle":"Powered by Anime.js","numberColor":"var(--color-accent)","layout":"stacked","align":"left","background":"transparent","numberEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1}}' />
    </layer>
    <cue id="hold-anime" label="hold-anime">
      <voice>Animate layout changes and responsive grids with Anime.js.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>

  <transition id="reel-push-7" effect="push" duration="12f" mode="insert" ease="power2.inOut" props='{"direction":"left"}' />

  <scene id="reel-mix" title="Mix" styles='{"background":"var(--color-bg)"}'>
    <layer id="engine-mix" z="10">
      <mix-and-match-demo />
    </layer>
    <layer id="label-mix" z="20">
      <chapter-heading props='{"number":"08","showNumber":false,"title":"Mix and match engines","subtitle":"Combine tools in one scene","numberColor":"var(--color-accent)","layout":"stacked","align":"left","background":"transparent","numberEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1},"titleEntrance":{"type":"fade","from":1,"to":1,"durationFrames":1}}' />
    </layer>
    <cue id="hold-mix" label="hold-mix">
      <voice>Mix multiple engines together in a single scene.</voice>
      <pause seconds="1s" />
    </cue>
  </scene>
</vml>
