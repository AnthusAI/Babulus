<videoml id="components-callout" title="Components Callout" fps="30" width="1920" height="1080">
  <voiceover provider="dry-run" />
  <scene id="callout-demo" title="callout-demo" styles='{"background":"var(--color-bg)"}'>
    <layer id="code" z="10">
      <code-block props='{"language":"typescript","code":"const frame = i => i * 2;\nconst motion = frame => Math.sin(frame / 8);","theme":"nord","position":{"y":260},"width":1200,"height":380}' />
    </layer>
    <layer id="callout" z="20">
      <video-callout props='{"text":"Frame-driven motion","pointerTarget":{"x":980,"y":350},"position":{"x":1180,"y":220}}' />
    </layer>
    <cue id="hold" label="hold">
      <pause seconds="6s" />
    </cue>
  </scene>
</videoml>
