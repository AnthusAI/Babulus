<vml id="transitions-branded" title="Transitions Branded" fps="30" width="1920" height="1080">
  <voiceover provider="dry-run" />

  <scene id="brand-a" title="Scene A" styles='{"background":"#7a1f1f"}'>
    <layer id="bg" z="0">
      <video-background props='{"color":"#7a1f1f"}' />
    </layer>
    <layer id="title" z="10">
      <video-title props='{"text":"Scene A","color":"var(--color-primary)","textColor":"var(--color-text)","position":{"y":540},"textAlign":"center"}' />
    </layer>
    <cue id="hold-a" label="hold-a">
      <pause seconds="2s" />
    </cue>
  </scene>

  <transition id="brand-overlay" effect="wipe" duration="120f" ease="power2.inOut" props='{"direction":"right"}'>
    <layer id="overlay" z="20" styles='{"opacity":0.95}'>
      <video-rectangle props='{"color":"#1f7a3a","xFrom":1920,"xTo":-260,"y":0,"width":260,"height":1080}' />
      <video-title props='{"text":"Company Name","color":"#0b0f1a","textColor":"#0b0f1a","fontSize":64,"fontWeight":700,"xFrom":2050,"xTo":-130,"yFrom":540,"yTo":540,"textAlign":"center","rotateDeg":90,"centerY":true}' />
    </layer>
  </transition>

  <scene id="brand-b" title="Scene B" styles='{"background":"#1f3a7a"}'>
    <layer id="bg" z="0">
      <video-background props='{"color":"#1f3a7a"}' />
    </layer>
    <layer id="title" z="10">
      <video-title props='{"text":"Scene B","color":"var(--color-primary)","textColor":"var(--color-text)","position":{"y":540},"textAlign":"center"}' />
    </layer>
    <cue id="hold-b" label="hold-b">
      <pause seconds="2s" />
    </cue>
  </scene>
</vml>
