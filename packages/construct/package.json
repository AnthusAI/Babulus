{
  "name": "@anthusai/babulus-construct",
  "version": "0.0.0",
  "description": "AWS CDK constructs for rendering Auritus speech on AWS Batch GPUs, for any host application.",
  "license": "MIT",
  "author": {
    "name": "Anthus AI",
    "organization": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnthusAI/Babulus.git",
    "directory": "packages/construct"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    ".jsii",
    "README.md"
  ],
  "scripts": {
    "build": "jsii",
    "watch": "jsii -w",
    "test": "jsii && jest",
    "package": "jsii-pacmak"
  },
  "jsii": {
    "outdir": "dist",
    "tsc": {
      "outDir": "lib",
      "rootDir": "src"
    },
    "targets": {
      "python": {
        "distName": "babulus-construct",
        "module": "babulus_construct"
      }
    }
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "aws-cdk-lib": "2.150.0",
    "constructs": "10.0.0",
    "jest": "^29.7.0",
    "jsii": "~5.9.0",
    "jsii-pacmak": "^1.140.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    }
  },
  "stability": "experimental",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
