{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "babulus": ["src/index.ts"],
      "babulus/dsl": ["src/dsl/index.ts"],
      "babulus/*": ["src/*"],
      "@/*": ["apps/studio-web/*"],
      "@babulus/shared": ["packages/shared/src/index.ts"],
      "@babulus/renderer": ["packages/renderer/src/index.ts"],
      "@videoml/player": ["../VideoML/player/src/index.ts"],
      "@videoml/player/react": ["../VideoML/player/src/react.tsx"],
      "@videoml/stdlib": ["../VideoML/stdlib/src/index.ts"],
      "@videoml/stdlib/dom": ["../VideoML/stdlib/src/dom/index.ts"],
      "@videoml/stdlib/tokens": ["../VideoML/stdlib/src/tokens/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "packages/dsl/**/*.ts",
    "packages/renderer/**/*.ts",
    "packages/renderer/**/*.tsx",
    "packages/shared/**/*.ts",
    "packages/shared/**/*.tsx",
    "packages/telemetry/**/*.ts",
    "packages/ui/**/*.ts",
    "packages/ui/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
